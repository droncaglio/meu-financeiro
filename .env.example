# ── PostgreSQL (Docker Compose) ───────────────────────────────────────────────
POSTGRES_DB=meu_financeiro
POSTGRES_USER=mfuser
POSTGRES_PASSWORD=change_me

# ── API ────────────────────────────────────────────────────────────────────────
# Em produção: postgresql://mfuser:SENHA@postgres:5432/meu_financeiro
DATABASE_URL="postgresql://mfuser:change_me@localhost:5432/meu_financeiro"

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
APP_PEPPER=change_me

# Email (SMTP)
# Dev: Mailtrap sandbox — porta 2525 ou 587 (STARTTLS). Nunca use 465 no Mailtrap.
# Prod: smtp.kinghost.net porta 465 (SSL automático via secure:true no mail.service.ts)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=change_me
SMTP_PASS=change_me
SMTP_FROM="Meu Financeiro <noreply@example.com>"

PORT=3000
NODE_ENV=production

# Throttle — defaults de produção já estão no código; só defina aqui para sobrescrever.
# Em dev, use valores altos para não travar nos testes:
# THROTTLE_LOGIN_LIMIT=1000
# THROTTLE_LOGIN_TTL=60000
# THROTTLE_REGISTER_LIMIT=1000
# THROTTLE_REGISTER_TTL=3600000
# THROTTLE_SENSITIVE_LIMIT=1000
# THROTTLE_SENSITIVE_TTL=900000
